# ── Core Application Settings ───────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key
APP_NAME="Campus Marketplace"
FRONTEND_URL=http://localhost:5000

# ── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://postgres:password@localhost:5432/campus_marketplace

# ── Campus / School Domain ───────────────────────────────────────────
# Restrict registration to student emails matching this domain
SCHOOL_EMAIL_DOMAIN=@up.edu.ph

# ── Real-Time Messaging (Socket.IO) ──────────────────────────────────
# Options: threading (default for local dev) or gevent (production)
SOCKETIO_ASYNC_MODE=threading

# ── Cloud Media Storage (Cloudinary) ─────────────────────────────────
# Required for user avatar, product image, and chat attachment uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Transactional Email (SMTP / Gmail App Password) ──────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
